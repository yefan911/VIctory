# Editor settings matching what the repository already holds: UTF-8 text,
# LF line ends (.gitattributes), spaces, no trailing whitespace, a final
# newline. Rust layout and width are rustfmt's (rustfmt.toml).
# See https://editorconfig.org.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{rs,toml}]
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

# Windows scripts are checked out with CRLF (.gitattributes).
[*.{cmd,ps1}]
end_of_line = crlf
